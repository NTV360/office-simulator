{
  "name": "office-simulator",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @office/client",
    "build": "npm run build -w @office/shared && npm run build -w @office/client && npm run build -w @office/server",
    "start": "npm run start -w @office/client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "verify:browser": "node tests/browser/verify.mjs",
    "verify:browser:record": "node tests/browser/verify.mjs --record",
    "verify:browser:thorough": "node tests/browser/verify.mjs --thorough",
    "check:docs": "node scripts/check-docs.mjs",
    "check:mutations": "node scripts/mutation-check.mjs",
    "layout:dump": "node scripts/dump-layout.mjs",
    "test:db": "node scripts/test-db.mjs",
    "dev:online": "node scripts/dev-online.mjs",
    "dev:records": "node scripts/dev-records.mjs",
    "seed": "node scripts/seed.mjs",
    "perf": "node scripts/perf.mjs",
    "pack:dump": "node scripts/dump-pack.mjs",
    "shots": "node scripts/shots.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:accounts": "node scripts/e2e-accounts.mjs",
    "e2e:together": "node scripts/e2e-together.mjs",
    "e2e:employees": "node scripts/e2e-employees.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
