# Copy to .env and edit. docker compose reads .env automatically. Never commit .env.

# Port the site is published on (open http://localhost:<WEB_PORT>)
WEB_PORT=8080

# Time zone for the containers (logs and the database clock)
TZ=UTC

# Database. Change the password for anything that other people can reach.
POSTGRES_USER=office
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office
