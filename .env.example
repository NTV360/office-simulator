# Copy to .env and edit. docker compose reads .env automatically. Never commit .env.

# Port the site is published on (open http://localhost:<WEB_PORT>)
WEB_PORT=16769

# Optional LAN HTTPS edge (start with `docker compose --profile lan up --build`).
# By default (LAN_TLS=internal) Caddy's own CA signs the certificates: install its root CA on each client, then use https://SITE_ADDRESS.
# SITE_ADDRESS=office.lan
# VOICE_SITE_ADDRESS=voice.office.lan
# LAN_HTTP_PORT=80
# LAN_HTTPS_PORT=443
# Real certificates instead, so no client installs anything (LAN_TLS=cloudflare): the names must be under a domain you own whose DNS is on
# Cloudflare, and answered inside the office by your own DNS; CLOUDFLARE_API_TOKEN is a token limited to Zone:DNS:Edit and Zone:Zone:Read for that
# one zone (keep it secret). Try it first with the staging endpoint (ACME_CA), then remove ACME_CA. See docs/VOICE.md.
# LAN_TLS=cloudflare
# CLOUDFLARE_API_TOKEN=
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Time zone for the containers (logs and the database clock)
TZ=UTC

# The simulated office (see docs/PHASE-2-BREAKDOWN.md). All optional.
# TICK_RATE=20      steps and snapshots per second
# SLOT_COUNT=40     how many staff the office starts with (at most 80, the number of desks)
# SIM_SPEED=1       clock speed, 0.25 to 8
# SIM_PAUSED=false  start with the clock stopped
# WORLD_SEED=       fix the randomness (tests only)
# PHYSICS=on        items fall, rest on each other and slide; off switches it off (docs/ITEMS-PHYSICS-PLAN.md)

# Accounts (all optional, but set these for anything other people can reach)
# ADMIN_USERNAME=   the first admin account, created at start-up if there is no admin yet
# ADMIN_PASSWORD=   its password (at least 8 characters; change it after the first login)
# COOKIE_SECURE=false  true once the site is served over HTTPS

# The admin password. It opens the admin page (http://<site>/admin) and the admin API (/api/admin/*, as `Authorization: Bearer <it>`).
# Leave empty to switch both off. Anyone who has this can make accounts, reset passwords and change the office, so keep it to the admins.
# ADMIN_TOKEN=

# The staff list. The server imports the company's employee records (names, departments, shifts, saved looks and desks, and who is clocked in)
# from Supabase into its own database, read-only, with a server-only key that never goes to a browser. Leave both empty and the office has
# no autonomous imported staff (apart from explicitly constructed test/local fixtures). The look and the desk someone chooses are kept in this server's database;
# an import never overwrites them. See docs/PHASE-6-BREAKDOWN.md, step 4.
# (the same two names `main` uses; the tables it may read are in supabase/grants.sql, see docs/SUPABASE.md)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=   the secret (service role) key: keep it to the server
# EMPLOYEE_IMPORT_MS=600000  how often the records are read again
# ATTENDANCE_MS=60000        how often who is clocked in is read (only while the clock is Live)

# Saving (the world is saved to the database and restored at start-up)
# SAVE_INTERVAL_MS=10000  how often the world is saved
# RESET_WORLD=false       true: ignore the saved world and start a fresh one (replaces the save)

# Voice (optional; LiveKit signing credentials stay server-side and never go to the browser)
# VOICE_ENABLED=false
# Local development: LIVEKIT_URL=ws://localhost:7880
# LAN profile: LIVEKIT_URL=wss://voice.office.lan  (add the HTTPS port when it is not 443: wss://voice.office.lan:8443)
# LIVEKIT_API_URL=http://voice:7880  server-only Room Service URL; do not expose this to browsers
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=change-this-server-only-secret
# VOICE_ROOM=office
# VOICE_RANGE=10
# LIVEKIT_NODE_IP=192.168.1.10  LAN address advertised for WebRTC candidates
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_PORT_RANGE_START=50000
# LIVEKIT_RTC_PORT_RANGE_END=50020

# Realtime (all optional)
# HELLO_TIMEOUT_MS=5000  how long a new connection has to say hello (with its ticket)
# MAX_UNJOINED_PER_ADDRESS=20  how many silent connections one address may have at once
# MAX_JOINED_MESSAGES_PER_SECOND=60  messages a playing client may send each second
# GRACE_MS=30000        how long a player's person stays under their control after the connection drops
# SESSION_SWEEP_MS=60000  how often open connections have their session checked again
# MAX_CLIENTS=200        connection limit
# CORS_ORIGIN=           allowed browser origins if the page is served from elsewhere (comma separated)

# Database. Change the password for anything that other people can reach.
POSTGRES_USER=office
POSTGRES_PASSWORD=change-me
POSTGRES_DB=office
