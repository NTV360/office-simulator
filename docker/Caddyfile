# Serves the built frontend and forwards API and realtime traffic to the server container.
# Plain HTTP on port 80 inside the container (the compose file publishes it on WEB_PORT).
# HTTPS for other computers on the network is added in a later phase (see docs/MULTIPLAYER-PLAN.md, 13.3).
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# the admin page (a second page of the site)
	@admin path /admin /admin/
	rewrite @admin /admin.html

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /socket.io/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
